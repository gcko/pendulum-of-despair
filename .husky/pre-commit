#!/usr/bin/env sh
# POSIX sh. husky runs this file as `sh -e .husky/pre-commit` (.husky/_/h),
# whatever the shebang says, and on Debian/Ubuntu that sh is dash. A dash
# without pipefail (macOS's /bin/dash is one) rejects `set -o pipefail` and
# the hook died on line 2. Nothing below depends on pipefail: each pipeline's
# verdict is its last command.
set -eu

# --- Block direct commits to main ---
BRANCH=$(git rev-parse --abbrev-ref HEAD)
if [ "$BRANCH" = "main" ]; then
  echo "ERROR: Direct commits to main are not allowed."
  echo "Create a feature branch and open a PR instead."
  exit 1
fi

# Gates A and C refuse to pass when .gd files are staged and gdlint or
# gdformat is missing: they used to sit inside `if command -v` with no else, so
# a machine without gdtoolkit committed GDScript nothing had checked (#472).
# They also refuse a tool whose `--version` differs from the pin, since CI
# checks with the pin and formatter rules change between releases (#477). In
# both cases the helper prints the install command for the pinned version
# (scripts/quality-gates/gdtoolkit-version.txt). No staged .gd, no requirement.
#
# addons/ is excluded by path COMPONENT, `(^|/)addons/`, in all three gates and
# in .github/workflows/static-gates.yml: game/addons/gut/ is vendored, but a
# directory merely named like it (scripts/myaddons/) is ours and is checked.
# shellcheck source=scripts/quality-gates/gdtoolkit-require.sh
. "$(git rev-parse --show-toplevel)/scripts/quality-gates/gdtoolkit-require.sh"

# === QUALITY GATE A: GDScript linting (gdtoolkit) ===
# Lint only staged .gd files (excludes addons/).
STAGED_GD=$(git diff --cached --name-only --diff-filter=ACM -- '*.gd' | grep -Ev '(^|/)addons/' || true)
if [ -n "$STAGED_GD" ]; then
    gdtoolkit_require gdlint "Gate A" || exit 1
    echo "=== Pre-commit: gdlint ==="
    echo "$STAGED_GD" | xargs gdlint
    echo "gdlint passed."
fi

# === QUALITY GATE B: JSON validation ===
# Verify all staged .json files are valid JSON (excludes addons/).
STAGED_JSON=$(git diff --cached --name-only --diff-filter=ACM -- '*.json' | grep -Ev '(^|/)addons/' || true)
if [ -n "$STAGED_JSON" ]; then
    echo "=== Pre-commit: JSON validation ==="
    FAIL=0
    for f in $STAGED_JSON; do
        if [ -f "$f" ]; then
            if ! python3 -c "import json,sys; json.load(open(sys.argv[1]))" "$f" 2>/dev/null; then
                echo "INVALID JSON: $f"
                FAIL=1
            fi
        fi
    done
    if [ "$FAIL" -eq 1 ]; then
        echo "JSON validation FAILED. Fix invalid files before committing."
        exit 1
    fi
    echo "JSON validation passed."
fi

# === QUALITY GATE C: gdformat check (formatting) ===
# Verify staged .gd files match gdformat output (excludes addons/).
# Only checks — does not auto-fix. Run `gdformat file.gd` to fix.
STAGED_GD=$(git diff --cached --name-only --diff-filter=ACM -- '*.gd' | grep -Ev '(^|/)addons/' || true)
if [ -n "$STAGED_GD" ]; then
    gdtoolkit_require gdformat "Gate C" || exit 1
    echo "=== Pre-commit: gdformat check ==="
    FAIL=0
    for f in $STAGED_GD; do
        if [ -f "$f" ]; then
            if ! gdformat --check "$f" 2>/dev/null; then
                echo "FORMAT MISMATCH: $f (run: gdformat $f)"
                FAIL=1
            fi
        fi
    done
    if [ "$FAIL" -eq 1 ]; then
        echo "gdformat check FAILED. Run gdformat on flagged files."
        exit 1
    fi
    echo "gdformat passed."
fi
