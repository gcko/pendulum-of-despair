#!/usr/bin/env bash
set -euo pipefail

GATE_DIR="scripts/quality-gates"

# Gate letters are a REGISTRY, not a running order. A letter names one gate
# for the life of the repo, is allocated once at the gate's introduction, and
# is never reused or renumbered — error reports, commit messages and issues
# cite gates by letter, so a letter that shifts meaning falsifies the record.
# A new gate takes the next free letter wherever in the run order it lands.
#
#   A  gdlint                     pre-commit
#   B  JSON validation            pre-commit
#   C  gdformat check             pre-commit
#   D  cross-file ID uniqueness   pre-push   check_id_uniqueness.py
#   E  stale-count scan           pre-push   check_stale_counts.py
#   F  scene reference validation pre-push   check_scene_refs.py
#   G  doc citation integrity     pre-push   check_doc_citations.py
#   H  GUT unit tests             pre-push
#   I  quality-gate self-tests    pre-push   test_quality_gates.py
#   J  dialogue script/JSON sync  pre-push   check_dialogue_sync.py
#   K  American-English spelling  pre-push   check_spelling.py
#   L  GUT script/test floor      pre-push   check_gut_baseline.py
#
# Each gate script's module docstring names its own letter; keep the two in
# step when editing either.

# === QUALITY GATE I: Quality-gate self-tests ===
# Runs first despite its letter: the gates below only protect the repo for as
# long as they still DETECT. A refactor that breaks a scan's matching makes it
# return "nothing found", which is indistinguishable from "nothing wrong" — so
# the scans are tested before they run, and a broken scan fails here rather
# than passing silently (#365).
# unittest, not pytest: stdlib only, so this needs no dev dependency.
echo "=== Pre-push: Quality-gate self-tests ==="
python3 -m unittest discover -s "$GATE_DIR" -p 'test_*.py' -q

# === QUALITY GATE D: Cross-file ID uniqueness scan ===
echo "=== Pre-push: Cross-file ID uniqueness ==="
python3 "$GATE_DIR/check_id_uniqueness.py"

# === QUALITY GATE E: Stale-count scan ===
echo "=== Pre-push: Stale-count scan ==="
python3 "$GATE_DIR/check_stale_counts.py"

# === QUALITY GATE F: Scene file reference validation ===
echo "=== Pre-push: Scene reference validation ==="
python3 "$GATE_DIR/check_scene_refs.py"

# === QUALITY GATE G: Doc citation integrity ===
echo "=== Pre-push: Doc citation integrity ==="
python3 "$GATE_DIR/check_doc_citations.py"

# === QUALITY GATE J: Dialogue script/JSON sync ===
echo "=== Pre-push: Dialogue script/JSON sync ==="
python3 "$GATE_DIR/check_dialogue_sync.py"

# === QUALITY GATE K: American-English spelling ===
# The house rule in docs/story/README.md § Writing Conventions used to live
# only as two grep commands written down in that document, which nothing ran.
# Five sweeps each missed residue the next one found, and two of them added
# fresh British spellings in the commit that was sweeping (#400).
echo "=== Pre-push: American-English spelling ==="
python3 "$GATE_DIR/check_spelling.py"

# === QUALITY GATE H: GUT unit tests ===
# Run all GUT tests headless. Requires Godot binary on PATH or at
# /Applications/Godot.app (macOS). Skip gracefully if Godot not found.
GODOT_BIN=""
if command -v godot >/dev/null 2>&1; then
    GODOT_BIN="godot"
elif [ -x "/Applications/Godot.app/Contents/MacOS/Godot" ]; then
    GODOT_BIN="/Applications/Godot.app/Contents/MacOS/Godot"
fi

if [ -n "$GODOT_BIN" ] && [ -f "game/addons/gut/gut_cmdln.gd" ]; then
    echo "=== Pre-push: Godot import ==="
    set +e
    IMPORT_LOG=$("$GODOT_BIN" --headless --path game/ --import 2>&1)
    IMPORT_EXIT=$?
    set -e
    if [ $IMPORT_EXIT -ne 0 ]; then
        echo "$IMPORT_LOG"
        echo "Godot import FAILED (exit $IMPORT_EXIT)."
        exit 1
    fi
    echo "Godot import passed."
    echo "=== Pre-push: GUT tests ==="
    TEMP_LOG=/tmp/gut_prepush.log
    # set +e around the pipeline so the status can be REPORTED rather than
    # aborting the hook wordlessly through `set -e`.
    set +e
    "$GODOT_BIN" --headless --path game/ -s addons/gut/gut_cmdln.gd 2>&1 | \
        sed 's/\x1b\[[0-9;]*m//g' | tee "$TEMP_LOG"
    GUT_EXIT=${PIPESTATUS[0]}
    set -e
    # Godot's own exit status, named rather than left for `set -e` to swallow
    # wordlessly. A printed summary is not evidence the process survived; the
    # status is.
    if [ "$GUT_EXIT" -ne 0 ]; then
        echo "Godot EXITED $GUT_EXIT during the GUT run. See $TEMP_LOG"
        tail -30 "$TEMP_LOG"
        exit 1
    fi
    # ABSENCE OF THE SUMMARY IS A FAILURE. This used to read
    #   if grep -q "Failing Tests" && ! grep -qE "Failing Tests\s+0"
    # which passed VACUOUSLY whenever the suite died, or collected nothing, before
    # printing a summary: the first grep found nothing, the conjunction went false,
    # and the gate reported that no test had failed. Nothing had run.
    #
    # The repair is not to demand a "Failing Tests" line - GUT 9.7.0 prints that
    # one ONLY when something failed, so on a green run it is legitimately
    # absent. The Run Summary totals are printed on every completed run, so they
    # are the evidence that the suite reached the end, and only once they are
    # present may a missing "Failing Tests" be read as zero.
    if ! grep -qE "^Scripts[[:space:]]+[0-9]+" "$TEMP_LOG" \
       || ! grep -qE "^Tests[[:space:]]+[0-9]+" "$TEMP_LOG"; then
        echo "GUT Run Summary MISSING from $TEMP_LOG - no 'Scripts'/'Tests' totals, so the"
        echo "suite never reached the end. Absence of the summary FAILS; it does not pass."
        tail -30 "$TEMP_LOG"
        exit 1
    fi
    if grep -qE "^Failing Tests[[:space:]]+" "$TEMP_LOG" \
       && ! grep -qE "^Failing Tests[[:space:]]+0[[:space:]]*$" "$TEMP_LOG"; then
        echo "GUT tests FAILED. Fix tests before pushing."
        grep -nE "^[[:space:]]+\[Failed\]" "$TEMP_LOG" | head -30 || true
        exit 1
    fi
    PASSING=$(grep -E "^Passing Tests " "$TEMP_LOG" | awk '{print $NF}' | tail -1 || true)
    echo "GUT tests passed ($PASSING passing)."

    # === QUALITY GATE L: GUT script/test count floor ===
    # `Failing Tests 0` says nothing about how many tests RAN. GUT 9.7.0 drops a
    # whole test file over a GDScript parse error and still reports a green
    # suite, so the floors in gut-baseline.txt are the only thing that notices
    # one going missing. They were read by scripts/gates.sh alone until #430,
    # and nothing runs that for you. Same implementation as gates.sh and CI, so
    # the three cannot drift apart in their parsing or their diagnosis.
    echo "=== Pre-push: GUT script/test count floor ==="
    python3 "$GATE_DIR/check_gut_baseline.py" --log "$TEMP_LOG"
else
    echo "=== Pre-push: GUT tests SKIPPED (Godot not found) ==="
fi

echo "=== All pre-push quality gates passed ==="
