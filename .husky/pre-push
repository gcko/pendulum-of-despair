#!/usr/bin/env bash
set -euo pipefail

GATE_DIR="scripts/quality-gates"

# Gate letters are a REGISTRY, not a running order. A letter names one gate
# for the life of the repo, is allocated once at the gate's introduction, and
# is never reused or renumbered — error reports, commit messages and issues
# cite gates by letter, so a letter that shifts meaning falsifies the record.
# A new gate takes the next free letter wherever in the run order it lands.
#
#   A  gdlint                     pre-commit
#   B  JSON validation            pre-commit
#   C  gdformat check             pre-commit
#   D  cross-file ID uniqueness   pre-push   check_id_uniqueness.py
#   E  stale-count scan           pre-push   check_stale_counts.py
#   F  scene reference validation pre-push   check_scene_refs.py
#   G  doc citation integrity     pre-push   check_doc_citations.py
#   H  GUT unit tests             pre-push
#   I  quality-gate self-tests    pre-push   test_quality_gates.py
#   J  dialogue script/JSON sync  pre-push   check_dialogue_sync.py
#   K  American-English spelling  pre-push   check_spelling.py
#   L  GUT summary/failures/floor pre-push   check_gut_baseline.py
#
# Each gate script's module docstring names its own letter; keep the two in
# step when editing either.

# === QUALITY GATE I: Quality-gate self-tests ===
# Runs first despite its letter: the gates below only protect the repo for as
# long as they still DETECT. A refactor that breaks a scan's matching makes it
# return "nothing found", which is indistinguishable from "nothing wrong" — so
# the scans are tested before they run, and a broken scan fails here rather
# than passing silently (#365).
# unittest, not pytest: stdlib only, so this needs no dev dependency.
echo "=== Pre-push: Quality-gate self-tests ==="
python3 -m unittest discover -s "$GATE_DIR" -p 'test_*.py' -q

# === QUALITY GATE D: Cross-file ID uniqueness scan ===
echo "=== Pre-push: Cross-file ID uniqueness ==="
python3 "$GATE_DIR/check_id_uniqueness.py"

# === QUALITY GATE E: Stale-count scan ===
echo "=== Pre-push: Stale-count scan ==="
python3 "$GATE_DIR/check_stale_counts.py"

# === QUALITY GATE F: Scene file reference validation ===
echo "=== Pre-push: Scene reference validation ==="
python3 "$GATE_DIR/check_scene_refs.py"

# === QUALITY GATE G: Doc citation integrity ===
echo "=== Pre-push: Doc citation integrity ==="
python3 "$GATE_DIR/check_doc_citations.py"

# === QUALITY GATE J: Dialogue script/JSON sync ===
echo "=== Pre-push: Dialogue script/JSON sync ==="
python3 "$GATE_DIR/check_dialogue_sync.py"

# === QUALITY GATE K: American-English spelling ===
# The house rule in docs/story/README.md § Writing Conventions used to live
# only as two grep commands written down in that document, which nothing ran.
# Five sweeps each missed residue the next one found, and two of them added
# fresh British spellings in the commit that was sweeping (#400).
echo "=== Pre-push: American-English spelling ==="
python3 "$GATE_DIR/check_spelling.py"

# === QUALITY GATE H: GUT unit tests ===
# Run all GUT tests headless. Godot comes from $GODOT_BIN, from PATH, or from
# /Applications/Godot.app (macOS), in that order.
#
# ABSENCE OF GODOT IS A FAILURE, NOT A SKIP. Until #430 everything below sat
# inside `if [ -n "$GODOT_BIN" ] && [ -f gut_cmdln.gd ]`, whose `else` branch
# printed "GUT tests SKIPPED (Godot not found)" and fell through to the success
# banner. On any machine without Godot the push therefore succeeded having run
# neither Gate H nor Gate L, on a tree whose suite had never run — the exact
# vacuity Gate L exists to close, with the guard against silently-skipped tests
# itself silently skipped. scripts/gates.sh already refused it; the hook
# refuses it now too, and the two agree.
GODOT_BIN="${GODOT_BIN:-}"
if [ -z "$GODOT_BIN" ] && command -v godot >/dev/null 2>&1; then
    GODOT_BIN="godot"
fi
if [ -z "$GODOT_BIN" ] && [ -x "/Applications/Godot.app/Contents/MacOS/Godot" ]; then
    GODOT_BIN="/Applications/Godot.app/Contents/MacOS/Godot"
fi
if [ -z "$GODOT_BIN" ]; then
    echo "=== Pre-push: GUT tests ==="
    echo "Godot NOT FOUND (set GODOT_BIN, put godot on PATH, or install it to"
    echo "/Applications/Godot.app) - refusing to report success on a tree whose GUT"
    echo "suite was never run. Gates H and L both need it; a skipped guard is not a"
    echo "passed one."
    exit 1
fi
if [ ! -f "game/addons/gut/gut_cmdln.gd" ]; then
    echo "=== Pre-push: GUT tests ==="
    echo "game/addons/gut/gut_cmdln.gd is MISSING, so the suite cannot run and Gates H"
    echo "and L have nothing to judge. Absence FAILS; it does not pass."
    exit 1
fi

# One headless Godot per machine, shared with scripts/gates.sh. A contended run
# collects FEWER scripts, which Gate L reads as a silently-skipped test file and
# blames on a healthy one; see scripts/quality-gates/godot-lock.sh. gates.sh has
# serialized Godot since it was written and the hook did not, which is how the
# two came to disagree about one clean tree (#430).
GODOT_LOCK_LABEL="$(basename "$PWD")"
# shellcheck source=scripts/quality-gates/godot-lock.sh
. "$GATE_DIR/godot-lock.sh"
godot_lock_acquire || exit 1

echo "=== Pre-push: Godot import ==="
set +e
IMPORT_LOG=$("$GODOT_BIN" --headless --path game/ --import 2>&1)
IMPORT_EXIT=$?
set -e
if [ $IMPORT_EXIT -ne 0 ]; then
    echo "$IMPORT_LOG"
    echo "Godot import FAILED (exit $IMPORT_EXIT)."
    exit 1
fi
echo "Godot import passed."

echo "=== Pre-push: GUT tests ==="
# Per-worktree, because this machine runs several. A fixed /tmp/gut_prepush.log
# was truncated by a sibling's `tee` while this run's Gate L was reading it, and
# the verdict is count-based: the reader either saw no summary at all or judged
# the neighbour's totals, since the LAST summary in the file wins.
TEMP_LOG="/tmp/gut_prepush_$(basename "$PWD").log"
# set +e around the pipeline so the status can be REPORTED rather than
# aborting the hook wordlessly through `set -e`.
set +e
"$GODOT_BIN" --headless --path game/ -s addons/gut/gut_cmdln.gd 2>&1 | \
    sed 's/\x1b\[[0-9;]*m//g' | tee "$TEMP_LOG"
GUT_EXIT=${PIPESTATUS[0]}
set -e
# Godot's own exit status, named rather than left for `set -e` to swallow
# wordlessly. A printed summary is not evidence the process survived; the
# status is.
if [ "$GUT_EXIT" -ne 0 ]; then
    echo "Godot EXITED $GUT_EXIT during the GUT run. See $TEMP_LOG"
    tail -30 "$TEMP_LOG"
    exit 1
fi

# === QUALITY GATE L: GUT summary, failures and script/test count floor ===
# Everything read OUT of the log is judged here and only here. The hook used to
# re-implement the summary-presence check and the failing-tests verdict in bash
# while CI re-implemented both again in YAML, so one rule had five copies; the
# comment claiming a single implementation was true of the floor alone (#430).
# judge_log() in check_gut_baseline.py performs all three:
#
#   * the Run Summary must be PRESENT - a suite that died before printing one
#     looks exactly like a suite with nothing to report, and absence fails;
#   * `Failing Tests` must be zero, read as zero only once the summary is there,
#     because GUT 9.7.0 prints that line only when something failed;
#   * `Scripts` and `Tests` must clear the floors in gut-baseline.txt, and every
#     collected test must actually PASS. A green suite says nothing about how
#     many tests ran: GUT drops a whole test file over a GDScript parse error
#     and still reports `Failing Tests 0`.
echo "=== Pre-push: GUT summary, failures and count floor ==="
python3 "$GATE_DIR/check_gut_baseline.py" --log "$TEMP_LOG"

echo "=== All pre-push quality gates passed ==="
